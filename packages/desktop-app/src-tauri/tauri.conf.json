{
  "$schema": "../gen/schemas/desktop-schema.json",
  "productName": "Canywhere",
  "version": "0.1.0",
  "identifier": "com.canywhere.desktop",
  "build": {
    "frontendDist": "../../desktop-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Canywhere",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Light",
        "backgroundColor": [255, 255, 255, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
