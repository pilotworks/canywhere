{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ChatKind": {
      "enum": [
        "workspace",
        "standalone"
      ],
      "type": "string"
    },
    "ChatStatus": {
      "enum": [
        "idle",
        "running",
        "awaitingApproval",
        "error"
      ],
      "type": "string"
    },
    "PermissionMode": {
      "enum": [
        "onRequest",
        "readOnly",
        "auto"
      ],
      "type": "string"
    }
  },
  "properties": {
    "createdAt": {
      "format": "int64",
      "type": "integer"
    },
    "externalThreadId": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/definitions/ChatKind"
    },
    "permissionMode": {
      "allOf": [
        {
          "$ref": "#/definitions/PermissionMode"
        }
      ],
      "default": "onRequest"
    },
    "providerId": {
      "type": "string"
    },
    "status": {
      "$ref": "#/definitions/ChatStatus"
    },
    "title": {
      "type": "string"
    },
    "updatedAt": {
      "format": "int64",
      "type": "integer"
    },
    "workspaceId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "createdAt",
    "id",
    "kind",
    "providerId",
    "status",
    "title",
    "updatedAt"
  ],
  "title": "Chat",
  "type": "object"
}