{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CommandExecStatus": {
      "enum": [
        "pendingApproval",
        "running",
        "completed",
        "failed"
      ],
      "type": "string"
    },
    "FileDiffStatus": {
      "enum": [
        "proposed",
        "applied",
        "rejected"
      ],
      "type": "string"
    },
    "MessageBlock": {
      "oneOf": [
        {
          "properties": {
            "content": {
              "type": "string"
            },
            "type": {
              "enum": [
                "text"
              ],
              "type": "string"
            }
          },
          "required": [
            "content",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "completed": {
              "type": "boolean"
            },
            "content": {
              "type": "string"
            },
            "type": {
              "enum": [
                "reasoning"
              ],
              "type": "string"
            }
          },
          "required": [
            "completed",
            "content",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "type": "string"
            },
            "type": {
              "enum": [
                "plan"
              ],
              "type": "string"
            }
          },
          "required": [
            "content",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "args": true,
            "callId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "output": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/definitions/ToolCallStatus"
            },
            "type": {
              "enum": [
                "tool_call"
              ],
              "type": "string"
            }
          },
          "required": [
            "args",
            "callId",
            "name",
            "status",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "patch": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "status": {
              "$ref": "#/definitions/FileDiffStatus"
            },
            "type": {
              "enum": [
                "file_diff"
              ],
              "type": "string"
            }
          },
          "required": [
            "patch",
            "path",
            "status",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "command": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "exitCode": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "output": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/definitions/CommandExecStatus"
            },
            "type": {
              "enum": [
                "command_exec"
              ],
              "type": "string"
            }
          },
          "required": [
            "command",
            "cwd",
            "status",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "MessageRole": {
      "enum": [
        "user",
        "agent",
        "system"
      ],
      "type": "string"
    },
    "ToolCallStatus": {
      "enum": [
        "running",
        "completed",
        "failed"
      ],
      "type": "string"
    }
  },
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/definitions/MessageBlock"
      },
      "type": "array"
    },
    "chatId": {
      "type": "string"
    },
    "createdAt": {
      "format": "int64",
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "role": {
      "$ref": "#/definitions/MessageRole"
    },
    "streaming": {
      "type": "boolean"
    },
    "turnId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "blocks",
    "chatId",
    "createdAt",
    "id",
    "role",
    "streaming"
  ],
  "title": "Message",
  "type": "object"
}